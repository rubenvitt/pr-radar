# Optional – ohne Token wird `gh auth token` verwendet. Fehlt beides, kann jeder Browser
# unter ⚙︎ einen eigenen Token hinterlegen (bleibt im localStorage, nicht auf dem Server).
# Fine-grained PAT: Repository-Zugriff auf die gewünschten Repos,
# Rechte: Pull requests (read/write für Auto-Merge), Contents (read), Commit statuses (read), Actions (read), Metadata (read).
GITHUB_TOKEN=

# Initiale Repo-Liste (nur beim ersten Start, danach data/config.json bzw. UI)
REPOS=owner/repo-a,owner/repo-b

PORT=4317
HOST=127.0.0.1
# Polling in Sekunden: normal / wenn irgendwo eine Pipeline läuft
POLL_SECONDS=30
POLL_SECONDS_ACTIVE=10
