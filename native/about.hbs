<h3>Icons8</h3>
<p>Symbole „Material Rounded“ von <a href="https://icons8.com">Icons8</a>, lizenziert über ein Icons8-Abo.</p>

<h2>Rust-Bibliotheken</h2>
<ul class="overview">
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p class="muted">Verwendet von:</p>
<ul class="used-by">
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
