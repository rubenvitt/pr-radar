// Cloudflare Workers Builds (Projekt pr-radar): liefert die statische
// Produktseite aus site/public aus, ohne Worker-Code.
//   Build command:  sh site/build.sh   (prüft Links und sperrt Platzhalter auf main)
//   Deploy command: npx wrangler deploy
// Siehe site/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pr-radar",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site/public",
    // Unbekannte Pfade bekommen site/public/404.html mit Status 404.
    "not_found_handling": "404-page"
  }
}
