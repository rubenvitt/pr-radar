// Cloudflare Workers Builds (Projekt pr-radar): liefert die statische
// Produktseite aus site/dist aus (von site/build.sh aus site/public erzeugt),
// ohne Worker-Code.
//   Build command:  sh site/build.sh   (prüft Links, setzt die Anschrift aus Build-Variablen ein)
//   Deploy command: npx wrangler deploy
// Siehe site/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pr-radar",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site/dist",
    // Unbekannte Pfade bekommen 404.html mit Status 404.
    "not_found_handling": "404-page"
  }
}
